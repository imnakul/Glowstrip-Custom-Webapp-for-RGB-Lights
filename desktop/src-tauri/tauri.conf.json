{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glowstrip",
  "version": "1.10.0",
  "identifier": "app.glowstrip.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/copy-web.mjs",
    "beforeBuildCommand": "node scripts/copy-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Glowstrip",
        "width": 400,
        "height": 720,
        "minWidth": 340,
        "minHeight": 520,
        "backgroundColor": "#00000000",
        "backgroundThrottling": "disabled",
        "center": true,
        "resizable": true,
        "transparent": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Control your RGB light strip",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
